#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIRECTORY=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPOSITORY_DIRECTORY=$(cd -- "$SCRIPT_DIRECTORY/.." && pwd)
PAGES_DIRECTORY="$REPOSITORY_DIRECTORY/site/pages"
PUBLIC_DIRECTORY="$REPOSITORY_DIRECTORY/public"
STATIC_DIRECTORY="$REPOSITORY_DIRECTORY/static"

if [[ -n ${LATEX2HTML_BIN:-} ]]; then
    LATEX2HTML_EXECUTABLE=$LATEX2HTML_BIN
else
    "$SCRIPT_DIRECTORY/bootstrap-latex2html"
    LATEX2HTML_EXECUTABLE="$REPOSITORY_DIRECTORY/.tools/latex2html/bin/latex2html"
fi

if [[ ! -x "$LATEX2HTML_EXECUTABLE" ]]; then
    printf 'LaTeX2HTML is not executable: %s\n' "$LATEX2HTML_EXECUTABLE" >&2
    exit 1
fi

LATEX2HTML_INSTALL_DIRECTORY=$(cd -- "$(dirname -- "$LATEX2HTML_EXECUTABLE")/.." && pwd)
LATEX2HTML_TEXINPUTS="$LATEX2HTML_INSTALL_DIRECTORY/texinputs"
if [[ -d "$LATEX2HTML_TEXINPUTS" ]]; then
    if [[ -n ${TEXINPUTS:-} ]]; then
        export TEXINPUTS="$LATEX2HTML_TEXINPUTS:$TEXINPUTS"
    else
        export TEXINPUTS="$LATEX2HTML_TEXINPUTS:"
    fi
fi

for required_command in latex pdflatex pdftocairo python3; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
        printf 'Missing required command: %s\n' "$required_command" >&2
        exit 1
    fi
done

if [[ "$PUBLIC_DIRECTORY" != "$REPOSITORY_DIRECTORY/public" ]]; then
    printf 'Refusing to replace unexpected output path: %s\n' "$PUBLIC_DIRECTORY" >&2
    exit 1
fi
rm -rf -- "$PUBLIC_DIRECTORY"
mkdir -p "$PUBLIC_DIRECTORY"

if [[ -d "$STATIC_DIRECTORY" ]]; then
    cp -a "$STATIC_DIRECTORY/." "$PUBLIC_DIRECTORY/"
fi

convert_page() {
    local source_file=$1
    local destination_directory=$2
    local source_stem
    local converter_log
    source_stem=$(basename -- "$source_file" .tex)

    mkdir -p "$destination_directory"
    converter_log="$destination_directory/.latex2html-$source_stem.log"
    if ! (
        cd "$REPOSITORY_DIRECTORY"
        "$LATEX2HTML_EXECUTABLE" \
            -split 0 \
            -no_navigation \
            -noaddress \
            -info 0 \
            -no_auto_link \
            -no_show_section_numbers \
            -html_version 5.0 \
            -image_type svg \
            -verbosity 0 \
            -dir "$destination_directory" \
            "$source_file"
    ) >"$converter_log" 2>&1; then
        cat "$converter_log" >&2
        return 1
    fi

    if grep -Eq \
        '\*\*\* LaTeXERROR|LaTeX produced no output|brace missing|Unknown commands:|No implementation found|There is no author' \
        "$converter_log"; then
        cat "$converter_log" >&2
        return 1
    fi

    if [[ -s "$destination_directory/WARNINGS" ]]; then
        cat "$destination_directory/WARNINGS" >&2
        return 1
    fi

    if [[ -s "$destination_directory/images.log" ]] &&
       grep -Eq '^!' "$destination_directory/images.log"; then
        cat "$destination_directory/images.log" >&2
        return 1
    fi

    rm -f -- \
        "$converter_log" \
        "$destination_directory/images.aux" \
        "$destination_directory/images.log" \
        "$destination_directory/images.out" \
        "$destination_directory/images.pdf" \
        "$destination_directory/images.pl" \
        "$destination_directory/images.tex" \
        "$destination_directory/labels.pl" \
        "$destination_directory/internals.pl" \
        "$destination_directory/WARNINGS" \
        "$destination_directory/$source_stem.aux" \
        "$destination_directory/$source_stem.log" \
        "$destination_directory/$source_stem.pdf" \
        "$destination_directory/$source_stem.pl"
}

while IFS= read -r -d '' source_file; do
    relative_source=${source_file#"$PAGES_DIRECTORY"/}
    relative_directory=$(dirname -- "$relative_source")
    if [[ "$relative_directory" == . ]]; then
        destination_directory=$PUBLIC_DIRECTORY
    else
        destination_directory="$PUBLIC_DIRECTORY/$relative_directory"
    fi
    convert_page "$source_file" "$destination_directory"
done < <(find "$PAGES_DIRECTORY" -type f -name index.tex -print0 | sort -z)

convert_page "$REPOSITORY_DIRECTORY/site/special/404.tex" "$PUBLIC_DIRECTORY"

for expected_page in \
    index.html \
    404.html \
    blog/index.html \
    build/index.html \
    test-latex/index.html; do
    if [[ ! -s "$PUBLIC_DIRECTORY/$expected_page" ]]; then
        printf 'Expected page was not generated: %s\n' "$expected_page" >&2
        exit 1
    fi
done

for math_directory in \
    "$PUBLIC_DIRECTORY/test-latex" \
    "$PUBLIC_DIRECTORY/blog/2025-10-08-monero-native-prediction-markets"; do
    if ! find "$math_directory" -maxdepth 1 -type f -name 'img*.svg' -print -quit | grep -q .; then
        printf 'Expected SVG math assets were not generated in: %s\n' "$math_directory" >&2
        exit 1
    fi
done

python3 "$SCRIPT_DIRECTORY/check_site.py" "$PUBLIC_DIRECTORY"

printf 'Built %s HTML pages in %s\n' \
    "$(find "$PUBLIC_DIRECTORY" -type f -name '*.html' | wc -l)" \
    "$PUBLIC_DIRECTORY"
